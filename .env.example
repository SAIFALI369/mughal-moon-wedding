# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Public values (safe in the browser bundle):
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SITE_URL="https://your-app.vercel.app"
# Server-only (set these in Vercel → Settings → Environment Variables, never in VITE_*):
#   SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"
#   GEMINI_API_KEY="xxx"   # optional: without it, card chat and the demo use the
#                          # wedding-concierge Edge Function (Supabase secret) instead
# Optional: database password connection string for scripts/migrate.mjs and
# scripts/cleanup-expired.mjs (Supabase → Settings → Database → Connection string):
#   LOVABLE_DB_MIGRATION_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
