# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Public values (safe in the browser bundle):
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SITE_URL="https://your-app.vercel.app"
# Server-only (set these in Vercel → Settings → Environment Variables, never in VITE_*):
#   SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Free AI pool — optional. With no keys at all the concierge still answers through
# three keyless providers (Kilo Code, OVHcloud, LLM7.io). Each provider below has a
# permanent free tier and accepts a comma-separated list of keys, so every extra
# free account multiplies the daily allowance. See docs/free-ai-router.md.
#   GEMINI_API_KEY="xxx"      # https://aistudio.google.com/apikey
#   GROQ_API_KEY="gsk_xxx"    # https://console.groq.com/keys
#   OPENROUTER_API_KEY="sk-or-v1-xxx"
#   CEREBRAS_API_KEY="csk_xxx"
#   MISTRAL_API_KEY="xxx"
#   NVIDIA_API_KEY="nvapi-xxx"
#   CLOUDFLARE_ACCOUNT_ID="abc123"   # both are required for Workers AI
#   CLOUDFLARE_API_TOKEN="xxx"
#   HF_TOKEN="hf_xxx"
#   AI_DAILY_LIMIT_HOMEPAGE="100"    # 0 removes the cap
#   AI_DAILY_LIMIT_CARD="100"
# Optional: database password connection string for scripts/migrate.mjs and
# scripts/cleanup-expired.mjs (Supabase → Settings → Database → Connection string):
#   LOVABLE_DB_MIGRATION_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
