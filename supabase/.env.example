# Supabase Edge Function secrets (`supabase secrets set --env-file supabase/.env`).
# This file is the template — keep real keys in your private copy only.
#
# Simran no longer depends on one Gemini key. Every provider below has a
# permanent free tier, and every value accepts a comma-separated list of keys so
# a second free account multiplies the pool instead of sitting idle.
# See docs/free-ai-router.md for the full walkthrough.

# ---------------------------------------------------------------------------
# Tier 1 — sign up for these first (all free, no credit card)
# ---------------------------------------------------------------------------
# Google AI Studio — https://aistudio.google.com/apikey
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.5-flash"
# Groq — https://console.groq.com/keys
# GROQ_API_KEY="gsk_xxx,gsk_yyy"
# OpenRouter (`:free` models) — https://openrouter.ai/keys
# OPENROUTER_API_KEY="sk-or-v1-xxx"
# Cerebras — https://cloud.cerebras.ai
# CEREBRAS_API_KEY="csk-xxx"
# Mistral AI (free mode is on by default) — https://console.mistral.ai/api-keys
# MISTRAL_API_KEY="xxx"
# NVIDIA NIM — https://build.nvidia.com
# NVIDIA_API_KEY="nvapi-xxx"
# Cloudflare Workers AI — needs BOTH values
# CLOUDFLARE_ACCOUNT_ID="abc123"
# CLOUDFLARE_API_TOKEN="xxx"

# ---------------------------------------------------------------------------
# Tier 2 — more free capacity, a few extra signup steps
# ---------------------------------------------------------------------------
# Z AI / GLM — https://open.bigmodel.cn/usercenter/apikeys
# ZAI_API_KEY="xxx"
# Cohere (trial key, 1,000 calls/month) — https://dashboard.cohere.com/api-keys
# COHERE_API_KEY="xxx"
# Hugging Face — https://huggingface.co/settings/tokens
# HF_TOKEN="hf_xxx"
# ModelScope — https://modelscope.cn/my/myaccesstoken
# MODELSCOPE_API_KEY="xxx"
# SiliconFlow — https://cloud.siliconflow.cn/account/ak
# SILICONFLOW_API_KEY="sk-xxx"
# Aion Labs — https://www.aionlabs.ai/app/api-keys/
# AION_API_KEY="xxx"
# Ollama Cloud — https://ollama.com/settings/keys
# OLLAMA_API_KEY="xxx"

# ---------------------------------------------------------------------------
# Keyless providers — no signup at all. On by default; nothing to configure.
# Kilo Code ~200 req/hour per IP · OVHcloud 2 RPM per IP per model · LLM7.io
# ---------------------------------------------------------------------------
# FREE_AI_ENABLE_KEYLESS="true"

# ---------------------------------------------------------------------------
# Pool controls (all optional)
# ---------------------------------------------------------------------------
# Cap answers per guest per day. `0` removes the cap for that surface.
# AI_DAILY_LIMIT_HOMEPAGE="100"
# AI_DAILY_LIMIT_CARD="100"
# Per-minute burst guard per visitor.
# AI_BURST_PER_MINUTE="30"
# Force a provider order, or drop one: FREE_AI_DISABLED_PROVIDERS="llm7"
# FREE_AI_PROVIDERS="gemini,groq,openrouter,cerebras,mistral,nvidia,kilo,ovh,llm7"
# Extra OpenAI-compatible endpoints, as a JSON array:
# FREE_AI_ROUTES='[{"name":"Self-hosted","url":"https://llm.example.com/v1/chat/completions","model":"qwen2.5","apiKey":""}]'
# Per-route and total timeouts in milliseconds.
# FREE_AI_ROUTE_TIMEOUT_MS="12000"
# FREE_AI_TOTAL_TIMEOUT_MS="20000"

# Exact production origin for the Edge Function CORS check.
# ALLOWED_ORIGIN="https://your-app.vercel.app"
